{
  "name": "rezaqsr/wp2laravel",
  "description": "WordPress helper functions and utilities for Laravel (wp2laravel).",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "RezaQsr\\Wp2Laravel\\": "src/"
    },
    "files": [

    ]
  },
  "autoload-dev": {
    "psr-4": {
      "RezaQsr\\Wp2Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RezaQsr\\Wp2Laravel\\Providers\\Wp2LaravelServiceProvider"
      ],
      "aliases": {
        "Wp2Laravel": "RezaQsr\\Wp2Laravel\\Facades\\Wp2Laravel"
      }
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  }
}
